! legacy_case.top -- a file in the old style: upper case throughout, CASE
! lines under the titles, plotter settings, numeric symbol codes.
! Nothing here was written for tdx, and all of it still plots:
!     tdx examples/legacy_case.top -o legacy.pdf
SET DEVICE POSTSCRIPT
SET FONT DUPLEX
TITLE TOP 'K2-3P R D2-3X0C12+3'
CASE     ' X XL W  X XFXLXX X'
TITLE LEFT 'DS/DW (MB/SR)'
CASE       'LG LF  GL LL '
TITLE BOTTOM 'P0K1 (GEV/C)'
CASE         'LX X   L  L '
SET LIMITS X FROM 0.0 TO 20.0 Y FROM 0.0 TO 12.0
SET SYMBOL 5O
SET ORDER X Y DY
 2.0   1.1   0.4
 4.0   3.6   0.5
 6.0   6.2   0.6
 8.0   8.4   0.7
10.0   9.7   0.8
12.0  10.3   0.9
14.0  10.1   1.0
16.0   9.4   1.1
PLOT
JOIN DOTS
